# Flask Configuration
FLASK_ENV=development
PORT=5000

# Set USE_MOCK_DATA=true for local mock development without Supabase.
# Set USE_MOCK_DATA=false to enforce live Supabase connection.
USE_MOCK_DATA=true

# Supabase Credentials (Keep SERVICE_ROLE_KEY confidential!)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
